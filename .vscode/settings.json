    "barrier": "cpp",
    "latch": "cpp",
    "semaphore": "cpp",
    "syncstream": "cpp",
    "valarray": "cpp",
    "__memory": "cpp"
  },
  "cSpell.ignoreRegExpList": [
    "\\bgl[A-Z][a-zA-Z0-9]*\\b",
    "\\bGL_[A-Z0-9_]+\\b",
    "\\bglfw[A-Z][a-zA-Z0-9]*\\b",
    "\\bGLFW_[A-Z0-9_]+\\b",
    "[^a-zA-Z0-9]-[D|W|f][a-zA-Z0-9-]*"
  ],
  "cSpell.ignorePaths": [
    ".git",
    ".vscode",
    "_log",
    "_build",
    "_external",
    "lib/glad"
  ],
  "cSpell.words": [
    "Allman",
    "asio",
    "assbin",
    "ASSIMP",
    "axgl",
    "bitangent",
    "bitangents",
    "blinn",
    "blit",
    "bugprone",
    "bundlefile",
    "Clearcoat",
    "Codegen",
    "cpptrace",
    "cubemap",
    "embedfile",
    "endforeach",
    "endfunction",
    "flatbuffer",
    "flatbuffers",
    "flatc",
    "fontface",
    "Framebuffer",
    "freetype",
    "ftxui",
    "gameloop",
    "glfw",
    "imgui",
    "Infacing",
    "inout",
    "Lightmap",
    "Metalness",
    "msaa",
    "MSVC",
    "mswsock",
    "MULTISAMPLE",
    "opengl",
    "orthogonalize",
    "Perlin",
    "Phong",
    "Renderable",
    "renderbuffer",
    "Shaderiv",
    "skybox",
    "spdlog",
    "stbi",
    "ubyte",
    "Unrenderable",
    "utfcpp"
  ],
  "cSpell.overrides": [
    {
      "filename": "_scripts/format.sh",
      "words": ["regextype"]
    },
    {
      "filename": "**/{CMakePresets.json,CMakeLists.txt,*.cmake}",
      "words": ["ARGN", "STREQUAL", "UNITTESTS"]
    },
    {
      "filename": "**/*.fbs",
      "words": ["BNDL", "MESG"]
    },
    {
      "filename": "**/*.{fs,vs}",
      "words": ["ivec", "texel", "isinf"]
    }
  ]
}
